# PostgreSQL Database Configuration
POSTGRES_DB=quiz_db
POSTGRES_USER=quiz
POSTGRES_PASSWORD=quiz_dev_password
POSTGRES_PORT=5432

# Prisma Database Connection URL
DATABASE_URL=postgresql://quiz:quiz_dev_password@localhost:5432/quiz_db?schema=public

# API Service Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://localhost:4201

# Authentication & Security (Local Development Placeholders - DO NOT USE IN PRODUCTION)
JWT_SECRET=local_dev_secret_key_change_in_production_do_not_use_in_prod
OTP_PEPPER=local_dev_otp_pepper_change_in_production
OTP_EXPIRES_IN_SECONDS=300
SESSION_EXPIRES_IN_DAYS=30
# Solo Quiz Configuration
# Default daily limit for games that award season points and affect monthly ranking
DAILY_RANKED_GAME_LIMIT=15
